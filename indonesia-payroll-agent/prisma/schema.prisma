  sequence         Int
  status           AgentStepStatus     @default(PENDING)
  inputSummary     Json                @default("{}") @map("input_summary")
  outputSummary    Json                @default("{}") @map("output_summary")
  citedSourceRefs  String[]            @default([]) @map("cited_source_refs")
  confidence       String?
  riskLevel        AuditRiskLevel      @default(R1) @map("risk_level")
  guardrailSummary Json                @default("{}") @map("guardrail_summary")
  tokenCount       Int                 @default(0) @map("token_count")
  costEstimateUsd  Decimal             @default(0) @map("cost_estimate_usd") @db.Decimal(18, 6)
  durationMs       Int?                @map("duration_ms")
  errorCode        String?             @map("error_code")
  errorMessage     String?             @map("error_message")
  startedAt        DateTime?           @map("started_at")
  completedAt      DateTime?           @map("completed_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  agentRun         AgentRun            @relation(fields: [agentRunId], references: [id], onDelete: Restrict)
  toolInvocations  ToolInvocation[]
  guardrailResults GuardrailResult[]
  outputReviews    AgentOutputReview[]

  @@unique([agentRunId, sequence])
  @@index([agentRunId, nodeType])
  @@index([status, createdAt])
  @@map("agent_steps")
}

model ToolInvocation {
  id               String               @id @default(cuid())
  agentRunId       String               @map("agent_run_id")
  agentStepId      String?              @map("agent_step_id")
  schemaVersionId  String?              @map("schema_version_id")
  toolName         String               @map("tool_name")
  toolVersion      String               @map("tool_version")
  status           ToolInvocationStatus @default(PENDING)
  permissionLevel  String               @map("permission_level")
  riskLevel        AuditRiskLevel       @default(R1) @map("risk_level")
  requiresApproval Boolean              @default(false) @map("requires_approval")
  approvalStatus   String               @default("NOT_REQUIRED") @map("approval_status")
  idempotencyKey   String?              @map("idempotency_key")
  parameterSummary Json                 @default("{}") @map("parameter_summary")
  outputSummary    Json                 @default("{}") @map("output_summary")
  errorCode        String?              @map("error_code")
  errorMessage     String?              @map("error_message")
  timeoutMs        Int                  @map("timeout_ms")
  retryCount       Int                  @default(0) @map("retry_count")
  formalRunAllowed Boolean              @default(false) @map("formal_run_allowed")
  startedAt        DateTime?            @map("started_at")
  completedAt      DateTime?            @map("completed_at")
  createdAt        DateTime             @default(now()) @map("created_at")
  agentRun         AgentRun             @relation(fields: [agentRunId], references: [id], onDelete: Restrict)
  agentStep        AgentStep?           @relation(fields: [agentStepId], references: [id], onDelete: SetNull)
  schemaVersion    ToolSchemaVersion?   @relation("ToolInvocationSchemaVersion", fields: [schemaVersionId], references: [id], onDelete: Restrict)
  guardrailResults GuardrailResult[]

  @@index([agentRunId, createdAt])
  @@index([agentStepId, createdAt])
  @@index([toolName, toolVersion])
  @@index([status, createdAt])
  @@map("tool_invocations")
}

model GuardrailResult {
  id               String            @id @default(cuid())
  agentRunId       String            @map("agent_run_id")
  agentStepId      String?           @map("agent_step_id")
  toolInvocationId String?           @map("tool_invocation_id")
  guardrailName    String            @map("guardrail_name")
  guardrailType    String            @map("guardrail_type")
  severity         GuardrailSeverity
  action           GuardrailAction
  triggered        Boolean           @default(false)
  resultSummary    Json              @default("{}") @map("result_summary")
  redactionApplied Boolean           @default(false) @map("redaction_applied")
  createdAt        DateTime          @default(now()) @map("created_at")
  agentRun         AgentRun          @relation(fields: [agentRunId], references: [id], onDelete: Restrict)
  agentStep        AgentStep?        @relation(fields: [agentStepId], references: [id], onDelete: SetNull)
  toolInvocation   ToolInvocation?   @relation(fields: [toolInvocationId], references: [id], onDelete: SetNull)

  @@index([agentRunId, createdAt])
  @@index([agentStepId, createdAt])
  @@index([toolInvocationId, createdAt])
  @@index([guardrailName, triggered])
  @@map("guardrail_results")
}

model AgentOutputReview {
  id                        String                    @id @default(cuid())
  agentRunId                String                    @map("agent_run_id")
  agentStepId               String?                   @map("agent_step_id")
  evalRunId                 String?                   @map("eval_run_id")
  reviewerId                String?                   @map("reviewer_id")
  decision                  AgentOutputReviewDecision
  riskLevel                 AuditRiskLevel            @default(R1) @map("risk_level")
  reviewSummary             String                    @map("review_summary")
  reviewedOutput            Json                      @default("{}") @map("reviewed_output")
  requiredCorrections       Json                      @default("{}") @map("required_corrections")
  effectiveObjectType       String?                   @map("effective_object_type")
  effectiveObjectId         String?                   @map("effective_object_id")
  effectiveObjectVersionRef String?                   @map("effective_object_version_ref")
  createdAt                 DateTime                  @default(now()) @map("created_at")
  agentRun                  AgentRun                  @relation(fields: [agentRunId], references: [id], onDelete: Restrict)
  agentStep                 AgentStep?                @relation(fields: [agentStepId], references: [id], onDelete: SetNull)
  evalRun                   EvalRun?                  @relation(fields: [evalRunId], references: [id], onDelete: SetNull)
  reviewer                  User?                     @relation("AgentOutputReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([agentRunId, createdAt])
  @@index([agentStepId, createdAt])
  @@index([evalRunId, decision])
  @@index([effectiveObjectType, effectiveObjectId])
  @@index([reviewerId, createdAt])
  @@index([decision, riskLevel])
  @@map("agent_output_reviews")
}
