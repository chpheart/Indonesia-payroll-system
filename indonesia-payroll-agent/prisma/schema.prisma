model User {
  id                      String                         @id @default(cuid())
  email                   String                         @unique
  displayName             String                         @map("display_name")
  status                  UserStatus                     @default(ACTIVE)
  createdAt               DateTime                       @default(now()) @map("created_at")
  updatedAt               DateTime                       @updatedAt @map("updated_at")
  userRoles               UserRole[]
  clientAccesses          ClientAccess[]                 @relation("ClientAccessUser")
  grantedAccesses         ClientAccess[]                 @relation("ClientAccessGrantor")
  createdAudits           AuditLog[]                     @relation("AuditActor")
  auditCorrections        AuditCorrection[]              @relation("AuditCorrectionActor")
  configVersions          ClientConfigVersion[]          @relation("ClientConfigVersionCreator")
  employeeVersions        EmployeeMasterVersion[]        @relation("EmployeeMasterVersionCreator")
  createdRuns             PayrollRun[]                   @relation("PayrollRunCreator")
  runAssignments          RunAssignment[]                @relation("RunAssignmentUser")
  assignedRuns            RunAssignment[]                @relation("RunAssignmentAssigner")
  triggeredEvents         RunStatusEvent[]               @relation("RunStatusEventTrigger")
  completedReminders      RunReminder[]                  @relation("RunReminderCompleter")
  rawInputItems           RawInputItem[]                 @relation("RawInputCreator")
  uploadedFiles           UploadedFileVersion[]          @relation("UploadedFileUploader")
  fileReplacements        FileReplacement[]              @relation("FileReplacementActor")
  ownedCases              CaseItem[]                     @relation("CaseItemOwner")
  resolvedCases           CaseItem[]                     @relation("CaseItemResolver")
  payrollComponents       PayrollComponent[]             @relation("PayrollComponentCreator")
  componentAliases        ClientComponentAlias[]         @relation("ComponentAliasCreator")
  confirmedAliases        ClientComponentAlias[]         @relation("ComponentAliasConfirmer")
  draftedRules            RuleVersion[]                  @relation("RuleVersionDrafter")
  publishedRules          RuleVersion[]                  @relation("RuleVersionPublisher")
  disabledRules           RuleVersion[]                  @relation("RuleVersionDisabler")
  ruleApprovals           RuleApproval[]                 @relation("RuleApprovalApprover")
  fxRatesCreated          FXRateVersion[]                @relation("FXRateCreator")
  fxRatesConfirmed        FXRateVersion[]                @relation("FXRateConfirmer")
  regressionRuns          RegressionRun[]                @relation("RegressionRunActor")
  promptVersions          PromptVersion[]                @relation("PromptVersionCreator")
  modelVersions           ModelVersion[]                 @relation("ModelVersionCreator")
  retrievalIndexes        RetrievalIndexVersion[]        @relation("RetrievalIndexCreator")
  toolSchemaVersions      ToolSchemaVersion[]            @relation("ToolSchemaCreator")
  agentRuns               AgentRun[]                     @relation("AgentRunTrigger")
  evalRuns                EvalRun[]                      @relation("EvalRunActor")
  agentOutputReviews      AgentOutputReview[]            @relation("AgentOutputReviewer")
  proposedChanges         ChangeProposal[]               @relation("ChangeProposalCreator")
  reviewedChanges         ChangeProposal[]               @relation("ChangeProposalReviewer")
  reviewedLedger          ChangeLedgerEntry[]            @relation("ChangeLedgerReviewer")
  confirmedMappings       FieldMappingVersion[]          @relation("FieldMappingConfirmer")
  modifiedInputs          StandardizedPayrollInput[]     @relation("StandardizedInputModifier")
  confirmedInputs         StandardizedPayrollInput[]     @relation("StandardizedInputConfirmer")
  confirmedMatches        EmployeeMatchCandidate[]       @relation("EmployeeMatchConfirmer")
  uploadedEvidence        Evidence[]                     @relation("EvidenceUploader")
  confirmedEvidence       Evidence[]                     @relation("EvidenceConfirmer")
  linkedEvidence          EvidenceLink[]                 @relation("EvidenceLinkActor")
  generatedPacks          CustomerConfirmationPack[]     @relation("ConfirmationPackGenerator")
  editedPackItems         CustomerConfirmationPackItem[] @relation("ConfirmationPackItemEditor")
  backfilledConfirmations CustomerConfirmation[]         @relation("CustomerConfirmationBackfiller")
  createdQuestions        QuestionItem[]                 @relation("QuestionCreator")
  resolvedQuestions       QuestionItem[]                 @relation("QuestionResolver")
  closedQuestions         QuestionItem[]                 @relation("QuestionCloser")
  questionEvents          QuestionStatusEvent[]          @relation("QuestionStatusActor")
  precheckRuns            PrecheckRun[]                  @relation("PrecheckRunActor")
  resolvedBlockingIssues  BlockingIssue[]                @relation("BlockingIssueResolver")
  payrollResults          PayrollResult[]                @relation("PayrollResultCalculator")

  @@map("users")
}

model Role {
  id             String         @id @default(cuid())
  code           RoleCode       @unique
  name           String
  description    String
  createdAt      DateTime       @default(now()) @map("created_at")
  userRoles      UserRole[]
  clientAccesses ClientAccess[]

  @@map("roles")
}

model UserRole {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model Client {
  id                            String                         @id @default(cuid())
  code                          String                         @unique
  name                          String
  legalEntityName               String?                        @map("legal_entity_name")
  status                        ClientStatus                   @default(ACTIVE)
  hasHistoricalPayroll          Boolean                        @default(false) @map("has_historical_payroll")
  createdAt                     DateTime                       @default(now()) @map("created_at")
  updatedAt                     DateTime                       @updatedAt @map("updated_at")
  accesses                      ClientAccess[]
  configVersions                ClientConfigVersion[]
  employees                     Employee[]
  payrollRuns                   PayrollRun[]
  rawInputItems                 RawInputItem[]
  uploadedFileVersions          UploadedFileVersion[]
  caseItems                     CaseItem[]
  auditLogs                     AuditLog[]
  componentAliases              ClientComponentAlias[]
  ruleVersions                  RuleVersion[]
  fxRateVersions                FXRateVersion[]
  agentRuns                     AgentRun[]
  changeProposals               ChangeProposal[]
  changeLedgerEntries           ChangeLedgerEntry[]
  fieldMappingVersions          FieldMappingVersion[]
  fieldMappingCandidates        FieldMappingCandidate[]
  standardizedInputs            StandardizedPayrollInput[]
  employeeMatchCandidates       EmployeeMatchCandidate[]
  evidences                     Evidence[]
  evidenceLinks                 EvidenceLink[]
  customerConfirmationPacks     CustomerConfirmationPack[]
  customerConfirmationPackItems CustomerConfirmationPackItem[]
  customerConfirmations         CustomerConfirmation[]
  questionItems                 QuestionItem[]
  precheckRuns                  PrecheckRun[]
  blockingIssues                BlockingIssue[]
  payrollResults                PayrollResult[]
  payrollResultLines            PayrollResultLine[]
  calculationTraces             CalculationTrace[]
  customerComparisonValues      CustomerComparisonValue[]

  @@map("clients")
}

model ClientAccess {
  id          String             @id @default(cuid())
  userId      String             @map("user_id")
  clientId    String             @map("client_id")
  roleId      String?            @map("role_id")
  status      ClientAccessStatus @default(ACTIVE)
  grantedById String?            @map("granted_by_id")
  grantedAt   DateTime           @default(now()) @map("granted_at")
  revokedAt   DateTime?          @map("revoked_at")
  user        User               @relation("ClientAccessUser", fields: [userId], references: [id], onDelete: Restrict)
  client      Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  role        Role?              @relation(fields: [roleId], references: [id], onDelete: Restrict)
  grantedBy   User?              @relation("ClientAccessGrantor", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([userId, clientId, roleId])
  @@index([clientId])
  @@map("client_accesses")
}

model AuditLog {
  id             String            @id @default(cuid())
  action         AuditAction
  objectType     AuditObjectType   @map("object_type")
  objectId       String            @map("object_id")
  riskLevel      AuditRiskLevel    @map("risk_level")
  actorUserId    String?           @map("actor_user_id")
  actorEmail     String            @map("actor_email")
  actorRoleCodes String[]          @default([]) @map("actor_role_codes")
  clientId       String?           @map("client_id")
  runId          String?           @map("run_id")
  purpose        String?
  ipAddress      String?           @map("ip_address")
  userAgent      String?           @map("user_agent")
  metadata       Json              @default("{}")
  createdAt      DateTime          @default(now()) @map("created_at")
  actor          User?             @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  client         Client?           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  payrollRun     PayrollRun?       @relation(fields: [runId], references: [id], onDelete: Restrict)
  corrections    AuditCorrection[]

  @@index([clientId, createdAt])
  @@index([runId, createdAt])
  @@index([action, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

model AuditCorrection {
  id             String   @id @default(cuid())
  auditLogId     String   @map("audit_log_id")
  note           String
  createdById    String?  @map("created_by_id")
  createdByEmail String   @map("created_by_email")
  createdAt      DateTime @default(now()) @map("created_at")
