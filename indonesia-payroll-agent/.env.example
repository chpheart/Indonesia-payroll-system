DATABASE_URL="postgresql://postgres:postgres@localhost:5433/indonesia_payroll_agent?schema=public"
LOCAL_FILE_STORE_ROOT="./storage/local"

# Development-only trusted actors. Ignored when NODE_ENV=production.
# Local requests may select an actor by x-user-id, but roles and client scopes
# are loaded only from this server-side registry or the local database.
DEV_DEFAULT_ACTOR_ID="demo-delivery"
DEV_ACTOR_REGISTRY_JSON='{"demo-delivery":{"email":"delivery.demo@example.local","roleCodes":["DELIVERY_SPECIALIST"],"authorizedClientIds":[]},"demo-admin":{"email":"admin.demo@example.local","roleCodes":["SYSTEM_ADMIN"],"authorizedClientIds":[]}}'
